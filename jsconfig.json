{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mjs"
, "src/app/(dashboard)/layout.tsx", "src/app/(dashboard)/DashboardShell.tsx", "src/components/layout/Header/Header.tsx", "src/components/layout/Header/UserMenu/UserMenu.tsx", "src/components/layout/Sidebar/Sidebar.tsx", "src/components/layout/Footer/Footer.tsx", "src/app/(dashboard)/page.tsx"  ],
  "exclude": ["node_modules"]
}